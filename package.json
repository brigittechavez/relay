{
  "name": "relay",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/build-icons.mjs",
    "seo": "node scripts/build-seo-files.mjs",
    "storybook": "ng run relay:storybook",
    "build-storybook": "ng run relay:build-storybook",
    "serve:ssr": "node dist/relay/server/server.mjs",
    "prepare": "husky",
    "prebuild": "npm run tokens && npm run seo",
    "prestart": "npm run tokens",
    "pretest": "npm run tokens",
    "prestorybook": "npm run tokens",
    "prebuild-storybook": "npm run tokens"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "latest",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@compodoc/compodoc": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/angular-vite": "^10.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "lucide-static": "^1.31.0",
    "playwright": "latest",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vite": "latest",
    "vitest": "^4.0.8"
  },
  "description": "RELAY — SaaS + marketplace de marketing de afiliados (proyecto de portafolio frontend).",
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
